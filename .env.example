# Pipeline configuration (no secrets — inject real values at runtime only)
PIPELINE_MODE=acceptance
PIPELINE_ARTIFACTS_DIR=./runs
PIPELINE_WORKSPACE_DIR=./workspace/runs
PIPELINE_MAX_IDENTICAL_RETRIES=3
PIPELINE_MAX_TOTAL_ATTEMPTS=5
PIPELINE_ALLOW_NETWORK=false
# Comma-separated hosts allowed for validator HTTP/GraphQL/browser (loopback always allowed)
PIPELINE_NETWORK_ALLOWLIST=
# Comma-separated hosts for redis_ping / postgres_ready / postgres driver
PIPELINE_STACK_HOST_ALLOWLIST=redis,postgres,127.0.0.1,localhost,::1
PIPELINE_LOG_LEVEL=info
PIPELINE_RUN_ID=
# Optional: writable roots inside the workspace (comma-separated relative paths)
PIPELINE_WRITE_ALLOWLIST=src,app,evaluation-demo/app

# Agent integration (OpenHands is the OSS runtime; mock needs no LLM/API)
PIPELINE_AGENT_MODE=mock
PIPELINE_AGENT_TIMEOUT_MS=120000
PIPELINE_OPENHANDS_COMMAND=openhands
PIPELINE_MOCK_AGENT_BEHAVIOR=success

# Safety kernel (fail closed): no production, host FS, SSH, unrestricted MiniPC,
# unlimited network, or unlimited retries. See docs/SAFETY.md.

# Never put API keys, tokens, or passwords in this file or in git.
# LLM credentials for OpenHands (if used) must be injected at runtime only.

# For the isolated Docker stack, copy `.env.docker.example` to `.env.docker`
# (gitignored) and see docs/DOCKER_SETUP.md.
