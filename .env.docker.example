# Non-production Docker Compose defaults for local isolation.
# Copy to `.env.docker` if you need local overrides. Never commit real secrets.

PIPELINE_ENV=nonprod
PIPELINE_MODE=acceptance
PIPELINE_ARTIFACTS_DIR=/pipeline/artifacts
PIPELINE_WORKSPACE_DIR=/pipeline/workspace
PIPELINE_MAX_IDENTICAL_RETRIES=3
PIPELINE_MAX_TOTAL_ATTEMPTS=5
PIPELINE_ALLOW_NETWORK=false
PIPELINE_LOG_LEVEL=info
PIPELINE_WRITE_ALLOWLIST=fixtures,src,app,evaluation-demo/app
# Agent integration (OpenHands is the OSS runtime; mock needs no LLM/API)
PIPELINE_AGENT_MODE=mock
PIPELINE_AGENT_TIMEOUT_MS=120000
PIPELINE_OPENHANDS_COMMAND=openhands
PIPELINE_MOCK_AGENT_BEHAVIOR=success
PIPELINE_HEALTH_REQUIRE_DEPS=true
PIPELINE_STACK_TIMEOUT_SECONDS=300

# Disposable local placeholders only — rotate if this file ever leaves your machine.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline_dev_only
POSTGRES_DB=pipeline
DATABASE_URL=postgresql://pipeline:pipeline_dev_only@postgres:5432/pipeline
REDIS_URL=redis://redis:6379/0
PGHOST=postgres
PGPORT=5432
PGUSER=pipeline
PGPASSWORD=pipeline_dev_only
PGDATABASE=pipeline
